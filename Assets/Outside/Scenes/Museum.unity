    - target: {fileID: 5546846749650900948, guid: 64e96864babe44084a28c2a4eb622e4a, type: 3}
      propertyPath: m_text
      value: 'Robotics has transformed modern surgery by extending the accuracy and
        control of human surgeons.

        This robot, inspired by the da Vinci
        Surgical System, allows surgeons to operate arms from a console by translating
        hand movements into extremely precise actions inside the body.'
      objectReference: {fileID: 0}
