    - target: {fileID: 5546846749650900948, guid: 64e96864babe44084a28c2a4eb622e4a, type: 3}
      propertyPath: m_text
      value: "Launched in 2020, NASA\u2019s Perseverance rover landed on Mars to
        study ancient environments and search for signs of past water and habitability.\nIts
        mission includes analyzing rocks, drilling core samples, and caching them
        for possible return to Earth."
      objectReference: {fileID: 0}
